{
  // Cmd+Shift+B runs the default build task.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Apple Visualized Music: build & run",
      "type": "shell",
      "command": "./build.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Apple Visualized Music: build, run & show logs",
      "type": "shell",
      "command": "./build.sh debug",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Apple Visualized Music: compile only (check errors)",
      "type": "shell",
      "command": "swift build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Apple Visualized Music: run tests",
      "type": "shell",
      "command": "./test.sh",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
