<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks audio input unless this is set. AVM never records
         the mic, but some headsets (AirPods) put a mic on the same audio device and
         macOS can count that as mic use (see NSMicrophoneUsageDescription in
         Info.plist). Actual mic access still needs the user's permission.
         No DYLD variables or unsigned libraries are needed. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- The hardened runtime also blocks Apple Events unless this is set. Reverb
         Room sends them to Music only: to read the current track, its artwork and the
         playhead, and for the player controls (play/pause, skip, seek, shuffle, repeat).
         The user still has to approve it (NSAppleEventsUsageDescription). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- SuperMassive branch only: AVM optionally loads Valhalla Supermassive (or any
         installed Audio Unit named "Supermassive") in place of the stock reverb. The
         hardened runtime's library validation otherwise refuses to load any code not
         signed by our own Team ID, which is every third-party plugin. This is a
         deliberate, scoped trade-off against that protection -- it lets AVM load
         ANY signed code, not just Supermassive, so don't carry it into a build that
         doesn't host third-party plugins. Nothing else changes: without this, AVM
         falls back to the stock reverb exactly as before. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
